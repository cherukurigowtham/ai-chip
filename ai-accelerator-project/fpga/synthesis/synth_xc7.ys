# ==============================================================================
# Yosys Synthesis Script: 8x8 Ternary Accelerator for Xilinx 7-Series (xc7)
# Target: Xilinx Zynq-7000 / Artix-7 (xc7z020 / xc7a100t)
# ==============================================================================

# Read SystemVerilog RTL files
read_verilog -sv ai-accelerator-project/ternary/rtl/dynamic_config_reg.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/pe_ternary.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/ternary_weight_unpacker.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/ternary_weight_buffer.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/systolic_array_ternary.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/ternary_controller.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/accelerator_ternary_top.sv
read_verilog -sv ai-accelerator-project/fpga/rtl/axi_lite_slave.sv
read_verilog -sv ai-accelerator-project/fpga/rtl/axi_stream_dma_adapter.sv
read_verilog -sv ai-accelerator-project/fpga/rtl/accelerator_ternary_axi_top.sv

# Elaborate hierarchy
hierarchy -check -top accelerator_ternary_axi_top

# Run Xilinx 7-Series synthesis (without external I/O pads for SoC IP integration)
synth_xilinx -top accelerator_ternary_axi_top -family xc7 -noiopad -flatten

# Print detailed resource utilization
stat -tech xilinx

# Write EDIF netlist
write_edif ai-accelerator-project/fpga/synthesis/accelerator_ternary_axi_top_xc7.edif

# Write JSON netlist for analysis
write_json ai-accelerator-project/fpga/synthesis/accelerator_ternary_axi_top_xc7.json
