# Yosys Synthesis Script for Universal BitNet-130 Processor Top
read_verilog -sv ai-accelerator-project/ternary/rtl/clkgate_x1.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/sparse_2_4_ternary_decompressor.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/sparse_quad_vec_decompressor.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/moe_topk_router.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/rope_2d_cordic.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/draft_token_engine.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/speculative_decoding_core.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/speculative_decoding_coprocessor.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/kv_cache_ring_buffer.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/noc_router_2d_vc4.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/d2d_link_layer.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/d2d_ucie_phy.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/riscv_xbitnet_core.sv
read_verilog -sv ai-accelerator-project/ternary/rtl/bitnet_universal_processor_top.sv

hierarchy -top bitnet_universal_processor_top
proc; opt; fsm; opt; memory; opt
techmap; opt

# Map to standard cell library
dfflibmap -liberty ai-accelerator-project/ternary/physical/pdk/nangate45.lib
abc -liberty ai-accelerator-project/ternary/physical/pdk/nangate45.lib -script +strash;map
clean
stat -liberty ai-accelerator-project/ternary/physical/pdk/nangate45.lib
write_verilog -noattr /tmp/bitnet_universal_processor_top.gate.v
